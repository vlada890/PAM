void main() {
  runApp(const GemStoreApp());
}

class GemStoreApp extends StatelessWidget {
  const GemStoreApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        fontFamily: 'sans-serif',
        scaffoldBackgroundColor: Colors.white,
        useMaterial3: true,
      ),
      home: const MainNavigationController(),
    );
  }
}

// ============================================================
// MAIN NAVIGATION
// ============================================================

class MainNavigationController extends StatefulWidget {
  const MainNavigationController({super.key});

  @override
  State<MainNavigationController> createState() =>
      _MainNavigationControllerState();
}

class _MainNavigationControllerState extends State<MainNavigationController> {
  bool _showProductDetails = false;
  int _cartCount = 0;

  void _openProduct() {
    setState(() => _showProductDetails = true);
  }

  void _closeProduct() {
    setState(() => _showProductDetails = false);
  }

  void _addToCart() {
    setState(() => _cartCount++);
  }

  @override
  Widget build(BuildContext context) {
    if (_showProductDetails) {
      return ProductDetailsScreen(
        onBack: _closeProduct,
        onAddToCart: _addToCart,
      );
    }

    return HomeScreen(
      cartCount: _cartCount,
      onProductTap: _openProduct,
    );
  }
}

