                ),
                const SizedBox(height: 5),
                Text(
                  comment,
                  style: const TextStyle(
                    fontSize: 12,
                    height: 1.4,
                    color: Colors.grey,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  // Color selector
  Widget _buildColorOption(int index, Color color) {
    final bool isSelected = _activeColorIdx == index;

    return GestureDetector(
      onTap: () {
        setState(() {
          _activeColorIdx = index;
        });
      },
      child: Container(
        margin: const EdgeInsets.only(right: 10),
        padding: const EdgeInsets.all(3),
        decoration: BoxDecoration(
          shape: BoxShape.circle,
          border: Border.all(
            color: isSelected ? const Color(0xFF5C9184) : Colors.transparent,
            width: 2,
          ),
        ),
        child: CircleAvatar(
          radius: 10,
          backgroundColor: color,
        ),
      ),
    );
  }

  // Size selector
  Widget _buildSizeOption(String size) {
    final bool isSelected = _activeSize == size;

    return GestureDetector(
      onTap: () {
        setState(() {
          _activeSize = size;
        });
      },
      child: Container(
        margin: const EdgeInsets.only(right: 8),
        width: 30,
        height: 30,
        decoration: BoxDecoration(
          color: isSelected ? const Color(0xFF202020) : const Color(0xFFF5F4F5),
          shape: BoxShape.circle,
        ),
        alignment: Alignment.center,
        child: Text(
          size,
          style: TextStyle(
            color: isSelected ? Colors.white : Colors.grey,
            fontSize: 11,
            fontWeight: FontWeight.bold,
          ),
        ),
      ),
    );
  }

  // Non-expandable section header
  Widget _buildDropdownRow(String title) {
    return Row(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        Text(
          title,
          style: const TextStyle(
            fontSize: 15,
            fontWeight: FontWeight.bold,
            color: Color(0xFF202020),
          ),
        ),
        const Icon(
          Icons.keyboard_arrow_down,
          color: Color(0xFF202020),
        ),
      ],
    );
  }

  // Similar-product card
  Widget _buildSimilarProductCard(
    String name,
    String price,
    Color bg,
  ) {
    return SizedBox(
      width: 145,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Container(
            width: double.infinity,
            height: 120,
            decoration: BoxDecoration(
              color: bg,
              borderRadius: BorderRadius.circular(10),
            ),
            child: const Icon(
              Icons.style,
              color: Colors.white38,
            ),
          ),
          const SizedBox(height: 6),
          Text(
            name,
            style: const TextStyle(
              fontSize: 11,
              fontWeight: FontWeight.w500,
            ),
          ),
          Text(
            price,
            style: const TextStyle(
              fontSize: 12,
              fontWeight: FontWeight.bold,
            ),
          ),
        ],
      ),
    );
  }
}
